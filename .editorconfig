root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = always:warning

[*.{json,md,toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.{props,targets,csproj,slnx}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
