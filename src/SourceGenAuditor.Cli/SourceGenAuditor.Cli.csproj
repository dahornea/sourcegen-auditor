<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sourcegen-auditor</ToolCommandName>
    <PackageId>SourceGenAuditor.Tool</PackageId>
    <Version>0.1.0</Version>
    <Title>SourceGen Auditor</Title>
    <Authors>SourceGen Auditor contributors</Authors>
    <Description>Audits one compiled Roslyn incremental source generator's observed output and cache behavior under a declared controlled scenario.</Description>
    <PackageProjectUrl>https://github.com/dahornea/sourcegen-auditor</PackageProjectUrl>
    <PackageTags>dotnet;dotnet-tool;csharp;roslyn;source-generators;incremental-generator;developer-tools;testing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SourceGenAuditor.Core/SourceGenAuditor.Core.csproj" />
    <InternalsVisibleTo Include="SourceGenAuditor.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="ClearUnreproducibleRepositoryMetadata"
          AfterTargets="_InitializeNuspecRepositoryInformationProperties"
          BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <RepositoryUrl></RepositoryUrl>
      <RepositoryType></RepositoryType>
      <RepositoryBranch></RepositoryBranch>
      <RepositoryCommit></RepositoryCommit>
    </PropertyGroup>
  </Target>
</Project>
